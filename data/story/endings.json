        "id": "bad_end",
        "background": "graveyard",
        "speaker": "narrator",
        "speakerName": "旁白",
        "text": "【坏结局】你转身走回成人社会。风很大，墓碑很静。——游戏结束。",
        "onEnterFlags": { "gameComplete": true, "endingAchieved": "bad" },
        "chapterEnd": true
      }
