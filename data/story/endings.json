        "id": "normal_end",
        "background": "modern_apartment",
        "speaker": "narrator",
        "speakerName": "旁白",
        "text": "【普通结局】羁绊很弱，但够你在虚无的日常里，找到一个坐标。——游戏结束。",
        "onEnterFlags": { "gameComplete": true, "endingAchieved": "normal" },
        "chapterEnd": true
