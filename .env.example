# Copy to .env and fill in your key
AI_API_KEY=sk-your-key-here

# Recommended for English game text: DeepSeek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Zhipu (智谱) — fine for Chinese, often replies in Chinese even with English prompts
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash

# Kimi / Moonshot — OK bilingual; set your key from platform.moonshot.cn
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=moonshot-v1-8k

# OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

AI_JSON_MODE=true
PORT=8765
